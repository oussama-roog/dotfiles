#!/usr/bin/env python3
"""
Bridge between Claude Code and the quickshell agents dot.

Claude Code calls this as a hook and as its status line command; every call
folds what it learns into one state file that services/Claude.qml watches:

    ~/.cache/qs-claude/state.json
    {
      "sessions": { "<session_id>": { name, cwd, status, action, ... } },
      "usage":    { "five_hour": {used_percentage, resets_at}, "seven_day": {...}, "updated": ms }
    }

Subcommands:
    hook          a Claude Code hook (event JSON on stdin); never prints, never blocks
    statusline    Claude Code's status line (session JSON on stdin); prints the line
    sweep         drops sessions whose claude process is gone
    focus <id>    focuses the terminal window (niri) running that session
    forget <id>   removes a session from the list

Statuses: idle (started, no prompt yet), working, waiting (permission prompt),
question (AskUserQuestion), done (turn finished).

Only open sessions are kept: a session leaves the list on SessionEnd, when its
process dies, or when its process moves on to another session (/clear, a
resume), since one claude process only ever runs one session at a time.

A claude that is only showing a background job (attached to the claude daemon)
still starts a session of its own; it is flagged `viewer` and left off the list.
"""

import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import qs_agent as qa  # noqa: E402
from qs_agent import now_ms, one_line, run  # noqa: E402

DIR = qa.cache_dir("claude")

# Token counts read off the transcript at most this often while tools run.
TOKENS_EVERY_S = 20


def State():
    return qa.State(DIR)


def describe_tool(name, inp):
    """A short label for a tool call: 'Edit Pill.qml', 'Bash nix build .#…'."""
    inp = inp if isinstance(inp, dict) else {}
    path = inp.get("file_path") or inp.get("notebook_path") or inp.get("path")
    if name == "Bash":
        return "Bash " + one_line(inp.get("command", ""), 80)
    if path and name in ("Read", "Edit", "Write", "MultiEdit", "NotebookEdit"):
        return name + " " + os.path.basename(path.rstrip("/"))
    if name in ("Grep", "Glob"):
        return name + " " + one_line(inp.get("pattern", ""), 60)
    if name in ("WebFetch",):
        return "Fetch " + one_line(inp.get("url", ""), 60)
    if name in ("WebSearch",):
        return "Search " + one_line(inp.get("query", ""), 60)
    if name in ("Task", "Agent"):
        return "Agent " + one_line(inp.get("description", ""), 60)
    if name.startswith("mcp__"):
        parts = name.split("__")
        return "MCP " + (parts[-1] if len(parts) > 2 else name)
    return name


def edit_counts(name, inp):
    """(+added, −removed) line counts for an edit tool call, or None."""
    if not isinstance(inp, dict):
        return None

    def lines(s):
        return len(s.splitlines()) if s else 0

    if name == "Edit":
        return lines(inp.get("new_string")), lines(inp.get("old_string"))
    if name == "MultiEdit":
        edits = inp.get("edits") or []
        return (sum(lines(e.get("new_string")) for e in edits),
                sum(lines(e.get("old_string")) for e in edits))
    if name == "Write":
        return lines(inp.get("content")), 0
    return None


def scan_transcript(path):
    """
    (context, output, title) from a session transcript: `context` is the tokens
    the latest turn sent (input + cache reads + cache writes), `output` the sum
    of every reply's output, counting each message id once (the transcript
    writes one line per content block of the same message), and `title` the
    session's name: a /rename wins over the generated one.
    """
    ctx, out, seen = 0, 0, set()
    ai_title, custom_title = "", ""
    try:
        with open(path, errors="replace") as f:
            for line in f:
                if '-title"' in line:
                    try:
                        entry = json.loads(line)
                    except ValueError:
                        continue
                    if entry.get("type") == "custom-title":
                        custom_title = entry.get("customTitle") or entry.get("title") or custom_title
                    elif entry.get("type") == "ai-title":
                        ai_title = entry.get("aiTitle") or ai_title
                    continue
                if '"usage"' not in line:
                    continue
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                if entry.get("isSidechain"):
                    continue
                msg = entry.get("message") or {}
                usage = msg.get("usage")
                if not isinstance(usage, dict):
                    continue
                ctx = (usage.get("input_tokens", 0) + usage.get("cache_read_input_tokens", 0)
                       + usage.get("cache_creation_input_tokens", 0))
                mid = msg.get("id")
                if mid not in seen:
                    seen.add(mid)
                    out += usage.get("output_tokens", 0)
    except OSError:
        return None
    return ctx, out, custom_title or ai_title


def was_interrupted(path):
    """
    True when the transcript's last real message is Claude Code's interrupt
    marker. Ctrl+C (or Esc at a permission prompt) fires no Stop hook, so this
    is the only trace that the turn ended. Reads just the file's tail.
    """
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 65536))
            tail = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return False
    for line in reversed(tail):
        if '"type":"user"' not in line and '"type":"assistant"' not in line:
            continue
        try:
            entry = json.loads(line)
        except ValueError:
            continue  # the first line of the tail may be cut
        if entry.get("isSidechain") or entry.get("type") not in ("user", "assistant"):
            continue
        content = (entry.get("message") or {}).get("content")
        if isinstance(content, list):
            return any(isinstance(c, dict) and str(c.get("text", "")).startswith("[Request interrupted")
                       for c in content)
        return isinstance(content, str) and content.startswith("[Request interrupted")
    return False


def mark_if_interrupted(s, t):
    """Moves a busy session to done when its turn was interrupted; True if it did."""
    if s.get("status") not in ("working", "waiting", "question") or not s.get("transcript"):
        return False
    if not was_interrupted(s["transcript"]):
        return False
    s["status"] = "done"
    s["last"] = "Interrupted"
    s["agents"] = 0
    s["updated"] = t
    return True


def alive(pid):
    """True while `pid` is still a claude process (a recycled pid doesn't count)."""
    return qa.alive(pid, "claude")


def daemon_peers():
    """Socket inodes of the processes attached to a claude daemon's control socket."""
    peers = set()
    for line in run(["ss", "-xH"]).splitlines():
        cols = line.split()
        # u_str ESTAB 0 0 /tmp/cc-daemon-1000/…/control.sock <inode> * <peer inode>
        if len(cols) >= 8 and "/cc-daemon-" in cols[4] and cols[4].endswith("/control.sock"):
            peers.add(cols[7])
    return peers


def is_viewer(pid, peers):
    """True when `pid` is a claude client attached to the daemon, showing a background job."""
    if not peers:
        return False
    try:
        fds = os.listdir(f"/proc/{int(pid)}/fd")
    except (OSError, ValueError, TypeError):
        return False
    for fd in fds:
        try:
            link = os.readlink(f"/proc/{int(pid)}/fd/{fd}")
        except OSError:
            continue
        if link.startswith("socket:[") and link[8:-1] in peers:
            return True
    return False


# ─── hook ────────────────────────────────────────────────────────────────────

def hook():
    try:
        ev = json.load(sys.stdin)
    except ValueError:
        return
    sid = ev.get("session_id")
    if not sid:
        return
    event = ev.get("hook_event_name", "")
    tool = ev.get("tool_name", "")
    inp = ev.get("tool_input")
    t = now_ms()

    with State() as st:
        sessions = st.data["sessions"]
        if event == "SessionEnd":
            if sessions.pop(sid, None) is not None:
                st.dirty = True
            return
        s = sessions.get(sid)
        if s is None:
            cwd = ev.get("cwd") or os.getcwd()
            s = sessions[sid] = {
                "id": sid,
                "cwd": cwd,
                "name": os.path.basename(cwd.rstrip("/")) or cwd,
                "status": "idle",
                "started": t,
                "action": "",
                "prompt": "",
                "last": "",
                "ctx": 0,
                "out": 0,
                "agents": 0,
            }
        st.dirty = True
        s["updated"] = t
        s["transcript"] = ev.get("transcript_path") or s.get("transcript", "")
        s["pid"] = qa.agent_pid("claude")
        qa.drop_superseded(sessions, sid, s["pid"])
        qa.note_tmux(s, event in ("SessionStart", "UserPromptSubmit"))

        if event == "SessionStart":
            s["status"] = "idle"
            s["viewer"] = is_viewer(s["pid"], daemon_peers())
        elif event == "UserPromptSubmit":
            s["status"] = "working"
            s["prompt"] = one_line(ev.get("prompt", ""))
            s["action"] = ""
            s["last"] = ""
            s["agents"] = 0
        elif event == "PreToolUse":
            s["status"] = "question" if tool == "AskUserQuestion" else "working"
            if tool == "AskUserQuestion":
                qs = (inp or {}).get("questions") or [{}]
                s["action"] = one_line(qs[0].get("question", "Has a question"))
            else:
                s["action"] = describe_tool(tool, inp)
            if tool in ("Task", "Agent"):
                s["agents"] = s.get("agents", 0) + 1
        elif event == "PermissionRequest":
            s["status"] = "waiting"
            s["action"] = describe_tool(tool, inp)
        elif event in ("PostToolUse", "PostToolUseFailure"):
            s["status"] = "working"
            counts = edit_counts(tool, inp)
            if counts:
                s["action"] = describe_tool(tool, inp) + f"  +{counts[0]} −{counts[1]}"
            if tool in ("Task", "Agent"):
                s["agents"] = max(0, s.get("agents", 0) - 1)
        elif event == "Notification":
            kind = ev.get("notification_type", "")
            msg = ev.get("message", "")
            if kind == "permission_prompt" or (not kind and "permission" in msg.lower()):
                s["status"] = "waiting"
                if not s.get("action"):
                    s["action"] = one_line(msg)
            elif kind == "idle_prompt" and s["status"] in ("waiting", "question", "working"):
                s["status"] = "done"
        elif event == "Stop":
            s["status"] = "done"
            s["agents"] = 0
            s["last"] = one_line(ev.get("last_assistant_message", "")) or s.get("last", "")

        # Token counts: on every turn boundary, and at most every few seconds mid-turn.
        boundary = event in ("Stop", "UserPromptSubmit", "SessionStart")
        stale = t - s.get("tokensAt", 0) > TOKENS_EVERY_S * 1000
        if s["transcript"] and (boundary or (event == "PostToolUse" and stale)):
            scan = scan_transcript(s["transcript"])
            if scan:
                s["ctx"], s["out"] = scan[0], scan[1]
                if scan[2]:
                    s["title"] = scan[2]
                s["tokensAt"] = t


# ─── status line ─────────────────────────────────────────────────────────────

def statusline():
    try:
        ev = json.load(sys.stdin)
    except ValueError:
        ev = {}

    limits = ev.get("rate_limits") if isinstance(ev.get("rate_limits"), dict) else None
    sid = ev.get("session_id")
    model = (ev.get("model") or {}).get("display_name", "")
    cw = ev.get("context_window") if isinstance(ev.get("context_window"), dict) else {}
    cur = cw.get("current_usage") if isinstance(cw.get("current_usage"), dict) else None

    with State() as st:
        if limits:
            usage = {k: v for k, v in limits.items() if isinstance(v, dict)}
            old = {k: v for k, v in st.data["usage"].items() if k != "updated"}
            # Rewrite when the numbers move, and every minute so "updated" stays honest.
            if usage != old or now_ms() - st.data["usage"].get("updated", 0) > 60_000:
                usage["updated"] = now_ms()
                st.data["usage"] = usage
                st.dirty = True
        s = st.data["sessions"].get(sid) if sid else None
        if s is not None:
            cost = ev.get("cost") if isinstance(ev.get("cost"), dict) else {}
            fresh = {
                "model": model,
                "title": ev.get("session_name") or s.get("title", ""),
                "ctxPct": cw.get("used_percentage"),
                "added": cost.get("total_lines_added"),
                "removed": cost.get("total_lines_removed"),
            }
            for k, v in fresh.items():
                if v not in (None, "") and s.get(k) != v:
                    s[k] = v
                    st.dirty = True
            if mark_if_interrupted(s, now_ms()):
                st.dirty = True
            if cur:
                ctx = (cur.get("input_tokens", 0) + cur.get("cache_read_input_tokens", 0)
                       + cur.get("cache_creation_input_tokens", 0))
                if ctx and ctx != s.get("ctx"):
                    s["ctx"] = ctx
                    st.dirty = True
        usage = st.data["usage"]

    parts = []
    if model:
        parts.append(model)
    cwd = (ev.get("workspace") or {}).get("current_dir") or ev.get("cwd")
    if cwd:
        parts.append(os.path.basename(cwd.rstrip("/")))
    for key, label in (("five_hour", "5h"), ("seven_day", "wk")):
        w = usage.get(key)
        if isinstance(w, dict) and isinstance(w.get("used_percentage"), (int, float)):
            parts.append(f"{label} {round(w['used_percentage'])}%")
    print(" · ".join(parts))


# ─── sweep / focus / forget ──────────────────────────────────────────────────

def sweep():
    t = now_ms()
    peers = daemon_peers()
    with State() as st:
        sessions = st.data["sessions"]
        # Newest first, so a process keeps the session it runs now.
        for sid in sorted(sessions, key=lambda k: sessions[k].get("updated", 0), reverse=True):
            s = sessions.get(sid)
            if s is None:
                continue
            if not alive(s.get("pid")):
                del sessions[sid]
                st.dirty = True
                continue
            if qa.drop_superseded(sessions, sid, s.get("pid")):
                st.dirty = True
            viewer = is_viewer(s["pid"], peers)
            if s.get("viewer", False) != viewer:
                s["viewer"] = viewer
                st.dirty = True
            if mark_if_interrupted(s, t):
                st.dirty = True
            # Sessions picked up mid-way (resumed before the hooks existed) get their title once.
            if not s.get("title") and not s.get("titleScanned") and s.get("transcript"):
                scan = scan_transcript(s["transcript"])
                s["titleScanned"] = True
                st.dirty = True
                if scan:
                    s["ctx"], s["out"] = scan[0] or s.get("ctx", 0), scan[1] or s.get("out", 0)
                    if scan[2]:
                        s["title"] = scan[2]
            if s.get("tmuxPane") and not s.get("where"):
                where = qa.tmux_where(s["tmuxPane"])
                if where:
                    s["where"] = where
                    st.dirty = True


def focus(sid):
    """
    Focuses the terminal running a session. A background job has no terminal
    of its own, so it is shown through a viewer (a claude attached to the
    daemon) instead, the most recently used one first.
    """
    with State() as st:
        sessions = {k: dict(v) for k, v in st.data["sessions"].items()}
    s = sessions.get(sid)
    if not s:
        return
    by_pid = qa.niri_windows()
    if by_pid is None:
        return
    if qa.focus_session(s, by_pid) or s.get("viewer"):
        return
    viewers = sorted((v for v in sessions.values() if v.get("viewer") and alive(v.get("pid"))),
                     key=lambda v: v.get("updated", 0), reverse=True)
    for v in viewers:
        if qa.focus_session(v, by_pid):
            return


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        if cmd == "hook":
            hook()
        elif cmd == "statusline":
            statusline()
        elif cmd == "sweep":
            sweep()
        elif cmd == "focus" and len(sys.argv) > 2:
            focus(sys.argv[2])
        elif cmd == "forget" and len(sys.argv) > 2:
            qa.forget(DIR, sys.argv[2])
        else:
            print(__doc__.strip(), file=sys.stderr)
            sys.exit(2)
    except Exception as e:  # a broken bridge must never break Claude Code
        if cmd != "statusline":
            print(f"claude-qs: {e}", file=sys.stderr)


if __name__ == "__main__":
    main()
