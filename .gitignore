# Ignore backup files
*.bak
*.backup

# Ignore log files
*.log

# Ignore the entire nvim undo directory
.config/nvim/undo/

# Ignore specific config files or directories
.config/kitty/*.bak
.config/kitty/tmux-client-*.log
.config/kitty/tmux-server-*.log

# Ignore all other potentially sensitive or unnecessary files
.config/*/*.bak
.config/*/*.log

# NixOS result symlinks
result
result-*

# Home-manager result symlinks
home-manager-result

# Theme-generated files (regenerated by theme-switcher.sh restore)
.config/hypr/colors.conf
.config/rofi/colors.rasi
.config/kitty/colors.conf
.config/ghostty/config
.config/dunst/dunstrc
.config/yazi/theme.toml
.config/quickshell/colors.json
.config/gtk-3.0/colors.css
.config/gtk-4.0/colors.css
.config/nvim/lua/oussama/core/theme.lua
.config/i3/colors
.config/polybar/colors.ini

# Database connection configs (contain passwords)
.config/db_connections.json
.env

# Editor swap files
*.swp

# Reference shells cloned for ideas
template/

# Certificates
certs/

# Python cache
__pycache__/
*.pyc

# Scratchpad: keep only its agent instructions
scratch/*
!scratch/CLAUDE.md
!scratch/GEMINI.md
!scratch/.claude/
scratch/.claude/*
!scratch/.claude/settings.json
