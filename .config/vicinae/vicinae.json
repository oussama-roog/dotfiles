{
    "closeOnFocusLoss": false,
    "considerPreedit": false,
    "faviconService": "twenty",
    "font": {
        "size": 10.5
    },
    "keybinds": {
        "toggle-action-panel": "control+b",
        "action.move-down": "control+j",
        "action.move-up": "control+k"
    },
    "popToRootOnClose": true,
    "rootSearch": {
        "searchFiles": false
    },
    "theme": {
        "name": "catppuccin-mocha"
    },
    "window": {
        "csd": true,
        "opacity": 0.98,
        "rounding": 10
    }
}
